# AI Interview Coach — backend configuration template.
# Copy to backend/.env and fill in real values. Every setting has a working
# default; only JWT_SECRET (production) and an LLM API key are strictly needed.

# --- Runtime ---------------------------------------------------------------
APP_NAME=AI Interview Coach
ENVIRONMENT=development
LOG_LEVEL=INFO
# auto = JSON in production, human-readable text elsewhere (text|json overrides).
LOG_FORMAT=auto
API_PREFIX=/api

# --- Database --------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ai_interview_coach

# --- Auth ------------------------------------------------------------------
# REQUIRED in production (refuses to boot with the default value).
JWT_SECRET=dev-only-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# --- CORS ------------------------------------------------------------------
# Comma-separated origins or a JSON array. '*' is rejected in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Rate limiting (per process, in-memory; 429 carries Retry-After) --------
RATE_LIMIT_ATTEMPTS=20
RATE_LIMIT_WINDOW_SECONDS=60
# Only enable behind a reverse proxy you control (it overwrites X-Forwarded-For).
TRUST_PROXY_HEADERS=false

# --- Uploads / request limits (bytes) --------------------------------------
MAX_UPLOAD_BYTES=5242880
MAX_BODY_BYTES=10485760
# Legacy local fallback; new uploads go to GridFS.
STORAGE_DIR=data/resumes

# --- Resume ingestion / GridFS ---------------------------------------------
# Analyze during the upload request (simple local setup) or in the job worker.
# Docker Compose sets this to false so OCR/preview work is off the request path.
RESUME_PROCESSING_INLINE=true
RESUME_BUCKET_NAME=resume_files
RESUME_PREVIEW_BUCKET_NAME=resume_previews
RESUME_PREVIEW_DPI=144
RESUME_MAX_PREVIEWS=40
RESUME_MAX_PAGES=60
RESUME_MAX_INLINE_TEXT_CHARS=200000
RESUME_MAX_EXTRACTION_CHUNKS=12
# Small chunks keep each request inside low token-per-minute provider limits.
RESUME_EXTRACTION_CHUNK_CHARS=5000
# Scanned pages are OCR'd with the Tesseract CLI; language packs are installed
# separately (e.g. "eng" or "eng+deu"). Missing binaries degrade gracefully.
RESUME_OCR_ENABLED=true
RESUME_OCR_LANGUAGES=eng
RESUME_OCR_DPI=200
RESUME_OCR_MIN_CHARS=40
RESUME_OCR_TIMEOUT_SECONDS=60
TESSERACT_CMD=tesseract
# DOCX page previews use LibreOffice; set an absolute path on Windows if needed.
RESUME_DOCX_PREVIEW_CONVERSION=true
LIBREOFFICE_CMD=soffice

# --- LLM (exactly one provider: openai | groq) -----------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- LLM cost tracking (Phase 9) --------------------------------------------
# Record token usage + estimated USD cost per call; rolled up (admin-only) at
# GET /api/usage/summary. Prices default to a built-in price book; override or
# add entries as "model=usd_per_1m_in:usd_per_1m_out" (semicolon-separated).
LLM_COST_TRACKING_ENABLED=true
LLM_PRICING_OVERRIDES=

# --- Server-side speech-to-text (none | openai | groq) ----------------------
# "none" disables server STT (browser Web Speech API only, Chromium-only).
# openai/groq reuse the API keys above for whisper-style transcription.
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_MODEL=whisper-1

# --- RAG (Qdrant + fastembed) ----------------------------------------------
RAG_ENABLED=true
# http(s) URL = Qdrant server/cloud; ":memory:" or a path = embedded store.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=data/models
RAG_TOP_K=5
KNOWLEDGE_BASE_DIR=../data/knowledge_base

# --- Outbound email ---------------------------------------------------------
# "console" logs the message instead of sending it (safe default).
MAIL_PROVIDER=console
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=AI Interview Coach

# --- Background jobs --------------------------------------------------------
# The worker is opt-in; the queue storage is always available.
JOBS_ENABLED=false
# Collection holding the internal background queue (kept separate from the
# recruiter-facing "jobs" collection).
JOBS_COLLECTION_NAME=background_jobs
JOBS_POLL_INTERVAL_SECONDS=5
JOBS_MAX_ATTEMPTS=3
JOBS_BACKOFF_SECONDS=30

# --- Registration mode ------------------------------------------------------
# In a screening deployment, public self-registration is disabled: staff are
# provisioned by invitation and candidates enter via magic links.
FEATURE_SCREENING_ENABLED=false

# --- AG-UI transport -------------------------------------------------------
# Opt-in thin transport for the practice answer turn. When disabled, the
# frontend keeps using the REST answer endpoint (the AG-UI route returns 501).
AGUI_ENABLED=false

# --- Staff bootstrap --------------------------------------------------------
# Optional seed admin created on startup (first privileged account). Leave
# blank once you have provisioned admins. Changing the seed user's role is a
# no-op once they exist.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Admin

# Public base URL of the frontend, used to build magic links and staff
# invitation links. It must match the origin users actually open.
FRONTEND_URL=http://localhost:3000

# --- Candidate invitations --------------------------------------------------
# How long a magic-link invitation stays usable before it expires.
INVITATION_TTL_DAYS=7

# --- Data retention & erasure (Phase 9) -------------------------------------
# Candidate session data (interview + recording + proctoring) older than this is
# destroyed by the `retention.purge` background job / admin endpoint. Invitation
# rows are anonymized, never deleted, so aggregate analytics survive.
DATA_RETENTION_DAYS=365
# The purge only runs when explicitly triggered; it is never destructive by
# accident.
RETENTION_PURGE_ENABLED=false
RETENTION_BATCH_LIMIT=100

# --- Encryption at rest (Phase 9) -------------------------------------------
# Encrypts app-managed secrets at rest (the ATS webhook signing secret). Accepts
# a Fernet key (urlsafe base64) or any passphrase, which is stretched to a key.
# When blank, secrets are stored in plaintext — development only.
FIELD_ENCRYPTION_KEY=

# --- Per-role limits (Phase 9) ----------------------------------------------
# Daily quotas as "role:action=max" pairs (semicolon-separated). `*` matches any
# role/action; a missing or 0 limit means unlimited.
ROLE_LIMITS=
# e.g. ROLE_LIMITS=recruiter:invitations=200;recruiter:exports=100;reviewer:api_keys=0

# --- Residency & data-processing (Phase 9) ----------------------------------
# Region label surfaced in the compliance record (GET /api/compliance).
DEPLOYMENT_REGION=
# Contact for data-protection / DPA enquiries, surfaced in the record.
DPA_CONTACT_EMAIL=

# --- Seats & spend caps (Phase 9) -------------------------------------------
# Maximum provisioned staff accounts (0 = unlimited).
MAX_STAFF_SEATS=0
# Monthly LLM spend ceiling in USD, checked before each AI call (0 = unlimited).
# Exceeding it blocks AI-backed endpoints with HTTP 429.
MONTHLY_LLM_BUDGET_USD=0
