# ---------------------------------------------------------------
# AI Interview Coach - environment configuration
# Copy this file to `.env` (repo root, used by docker compose) and to
# `backend/.env` (read by the FastAPI app). NEVER commit real `.env` files.
# ---------------------------------------------------------------

# Application
APP_NAME=AI Interview Coach
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api

# CORS (comma separated) - must include the port the frontend runs on
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# MongoDB (the app uses MongoDB/Motor, not PostgreSQL)
# Local / Docker Compose:
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ai_interview_coach
MONGO_PORT=27017
# Hosted example:
# MONGO_URI=mongodb+srv://user:password@cluster.example.net/?tls=true

# Where uploaded resumes are stored (relative paths resolve against backend/)
STORAGE_DIR=data/resumes
MAX_UPLOAD_BYTES=5242880

# JWT - generate a strong value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# Brute-force protection for /api/auth/login and /api/auth/register
RATE_LIMIT_ATTEMPTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# LLM provider: "openai" or "groq"
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
