# ---------------------------------------------------------------
# AI Interview Coach - environment configuration (root).
# This file is the Docker Compose interpolation source: copy it to `.env`
# at the repo root. It only needs the vars docker-compose.yml reads.
# The full FastAPI app settings live in `backend/.env.example` — copy THAT
# to `backend/.env` for the backend's own configuration.
# NEVER commit real `.env` files.
# ---------------------------------------------------------------

# Application
APP_NAME=AI Interview Coach
ENVIRONMENT=development
LOG_LEVEL=INFO
# Log output: auto (JSON in production, text elsewhere), or force text|json.
LOG_FORMAT=auto
API_PREFIX=/api

# CORS (comma separated) - must include the port the frontend runs on
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Public frontend origin used to build candidate magic links and staff invites.
# Docker Compose passes this into the backend, overriding backend/.env.
FRONTEND_URL=http://localhost:3000

# MongoDB (the app uses MongoDB/Motor, not PostgreSQL)
# Local / Docker Compose:
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ai_interview_coach
MONGO_PORT=27017
# Hosted example:
# MONGO_URI=mongodb+srv://user:password@cluster.example.net/?tls=true

# Legacy local resume directory (new uploads use GridFS).
STORAGE_DIR=data/resumes
MAX_UPLOAD_BYTES=5242880
# Whole request bodies above this size are refused before they are read (bytes)
MAX_BODY_BYTES=10485760
# Compose runs resume OCR/preview work in the job worker. Set true only for a
# single-process setup without a worker.
RESUME_PROCESSING_INLINE=false
RESUME_OCR_LANGUAGES=eng

# JWT - generate a strong value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# First admin account. This file is only read by Docker Compose, so set these
# in backend/.env (see backend/.env.example) where the app reads them.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Admin

# Throttling (per client IP, per process) for login/register and for the
# AI-backed endpoints (resume upload, job-description create).
RATE_LIMIT_ATTEMPTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Enable ONLY when a reverse proxy you control sits in front of the API and
# sets X-Forwarded-For itself. Left off otherwise: clients could forge the
# header and pick their own rate-limit key.
TRUST_PROXY_HEADERS=false

# LLM provider: "openai" or "groq"
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# RAG (Qdrant vector store + local fastembed embeddings, no API key needed)
# Set RAG_ENABLED=false to A/B question quality with and without retrieval.
RAG_ENABLED=true
# Docker Compose: http://qdrant:6333 inside the network, http://localhost:6333
# from the host. Without Docker you can use an embedded store instead:
#   QDRANT_URL=:memory:test (per-process, tests) or QDRANT_URL=data/qdrant
#   (persistent local directory under backend/).
QDRANT_URL=http://localhost:6333
# Embedding model downloaded on first use into EMBEDDING_CACHE_DIR.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=data/models
# Knowledge chunks injected per question (allowed range 3-5).
RAG_TOP_K=5
# Directory ingested by `python -m scripts.ingest_knowledge_base`.
KNOWLEDGE_BASE_DIR=../data/knowledge_base
